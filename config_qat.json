{
  "run": {
    "mode"   : "train",
    "seed"   : 0,
    "device" : "auto",
    "log_dir": "log"
  },
  "data": {
    "dataset"      : "cifar10",
    "root"         : "data",
    "image_size"   : 32,
    "normalization": "zero_one",
    "batch_size"   : 128,
    "num_workers"  : 0
  },
  "model": {
    "name"        : "qat_cifar_cnn",
    "num_classes" : 10,
    "load_weight" : false,
    "weight_path" : ""
  },
  "quantization": {
    "weight_bits"             : 8,
    "activation_bits"         : 8,
    "input_bits"              : 8,
    "rounding"                : "ties_away_from_zero",
    "activation_range_momentum": 0.95
  },
  "train": {
    "epochs"                    : 20,
    "learning_rate"             : 0.001,
    "minimum_learning_rate"     : 0.00001,
    "weight_decay"              : 0.0001,
    "label_smoothing"           : 0.0,
    "mixup_alpha"               : 0.8,
    "cutmix_alpha"              : 1.0,
    "mixup_probability"         : 1.0,
    "mixup_switch_probability"  : 0.5
  }
}
